parameters:
	level: 5
	paths:
		- bugbottle.php
		- includes
	bootstrapFiles:
		- phpstan-bootstrap.php
	scanFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# `wp-admin/includes/class-wp-list-table.php` belongs to the WordPress
		# install the plugin is dropped into, which is not a dependency of this
		# repository and is not on disk during analysis. The class itself comes
		# from the stubs, so everything using it is still checked; only the
		# existence of the file behind `ABSPATH` cannot be.
		-
			identifier: requireOnce.fileNotFound
			path: includes/class-reports-list-table.php
